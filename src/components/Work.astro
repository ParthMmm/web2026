---
type Props = {
	url?: string;
	title: string;
	description: string;
};

const { url, title, description } = Astro.props;
---

  <div class='mb-5'>
    <div class='flex flex-col items-start gap-1'>
      {
        url ? (
          <a
            href={url}
            class='card-title font-medium tracking-tight text-900 dark:text-100'
          >
            {title}
          </a>
        ) : (
          <div class='font-medium tracking-tight text-900 dark:text-100'>{title}</div>
        )
      }
      <span class='text-sm font-light text-600 dark:text-400'>{description}</span>
    </div>
  </div>

<style>
  @media (hover: hover) and (pointer: fine) {
    .card-title:hover {
      color: oklch(55% 0.18 250);
    }
    :global(.dark) .card-title:hover {
      color: oklch(65% 0.15 250);
    }
    .card-title {
      transition: color 150ms ease;
    }
  }
</style>
