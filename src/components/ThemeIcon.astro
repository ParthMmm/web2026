---
---

<button id="themeToggle" type="button" aria-label="Switch to dark theme">
  <span class="icon-wrapper">
    <svg class="theme-icon sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4.25" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
      </g>
    </svg>
    <svg class="theme-icon moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path
        d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.25 8.25 0 1 0 10.2 10.2Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</button>

<style>
  #themeToggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-block: -0.375rem;
    /* Optical outdent so the glyph, not the padding box, lands on the text
       edge. Must follow the inline axis or it pulls the wrong way in RTL. */
    margin-inline-end: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--color-ink-3);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    #themeToggle:hover {
      background-color: var(--color-hover);
      color: var(--color-ink-1);
    }
  }

  #themeToggle:active {
    background-color: var(--color-pressed);
  }

  .icon-wrapper {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
  }

  /* One glyph swaps for the other in place. This is state indication,
     not decoration, so it is quick and it stops at the swap. */
  .theme-icon {
    position: absolute;
    inset: 0;
    transition:
      transform 300ms cubic-bezier(0.34, 1.36, 0.64, 1),
      opacity 200ms ease;
  }

  .sun {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
  .moon {
    transform: rotate(-90deg) scale(0.5);
    opacity: 0;
  }
  :global(.dark) .sun {
    transform: rotate(90deg) scale(0.5);
    opacity: 0;
  }
  :global(.dark) .moon {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
</style>

<script is:inline>
  (() => {
    const KEY = "theme-override";
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

    /* A browser that blocks site data throws on every use of localStorage,
       even reading the property. The visitor's choice then lasts for the
       page, and the theme and the toggle still work. */
    const choice = {
      forget: (key) => {
        try {
          localStorage.removeItem(key);
        } catch {
          /* Nothing was stored. */
        }
      },
      read: () => {
        try {
          return localStorage.getItem(KEY);
        } catch {
          return null;
        }
      },
      write: (theme) => {
        try {
          localStorage.setItem(KEY, theme);
        } catch {
          /* The choice lasts until the page unloads. */
        }
      },
    };

    /* "theme" held the resolved theme, not a choice, so it can't be trusted. */
    choice.forget("theme");
    const stored = choice.read();

    const CANVAS = { dark: "#1f1d17", light: "#fcf6e9" };

    const apply = (isDark) => {
      document.documentElement.classList.toggle("dark", isDark);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", isDark ? CANVAS.dark : CANVAS.light);
      const button = document.querySelector("#themeToggle");
      button?.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
    };

    apply(stored ? stored === "dark" : systemDark.matches);
    systemDark.addEventListener("change", (event) => {
      if (!choice.read()) {
        apply(event.matches);
      }
    });

    const toggle = () => {
      const isDark = !document.documentElement.classList.contains("dark");
      apply(isDark);
      if (isDark === systemDark.matches) {
        choice.forget(KEY);
      } else {
        choice.write(isDark ? "dark" : "light");
      }
    };

    document.addEventListener("click", async (event) => {
      if (!event.target.closest?.("#themeToggle")) {
        return;
      }
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced || !document.startViewTransition) {
        toggle();
        return;
      }
      await document.startViewTransition(toggle).ready;
      document.documentElement.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 240,
        easing: "ease",
        pseudoElement: "::view-transition-new(root)",
      });
    });
  })();
</script>
