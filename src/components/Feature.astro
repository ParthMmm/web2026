---
type Props = {
	title: string;
	description: string;
	url: string;
	stack: string;
};

const { title, description, url, stack } = Astro.props;
---

<section class="feature">
  <div class="media"><slot /></div>
  <div class="caption">
    <h3 class="name">
      <a href={url}>{title}</a>
    </h3>
    <p class="desc">{description}</p>
    <p class="stack">{stack}</p>
  </div>
</section>

<style>
  .feature {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .feature:first-child {
    padding-block-start: 0;
  }

  .media {
    margin-block-end: 1.25rem;
  }

  .caption {
    display: grid;
    gap: 0.375rem;
  }

  .name {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-feature);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--color-ink-1);
  }

  /* The marker that ranks this above the index rows below. */
  .name::before {
    content: "";
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background-color: var(--color-primary);
  }

  .name a {
    text-decoration-color: var(--color-primary-quiet);
  }

  .desc {
    margin: 0;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .stack {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
</style>
