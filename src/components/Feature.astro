---
import { siteLabel } from "../data/site";

type Props = {
	title: string;
	description: string;
	url: string;
	/** Short tag: what the thing is built on. */
	stack: string;
	tone: "green" | "orange";
	/** The thing itself, linked beside the stack when it lives elsewhere. */
	site?: string;
};

const { title, description, url, stack, tone, site } = Astro.props;
---

<section class={`feature tone-${tone}`}>
  <div class="media"><slot /></div>
  <div class="caption">
    <h3 class="name">
      <a href={url}>{title}</a>
    </h3>
    <p class="desc">{description}</p>
    <p class="stack">
      {stack}
      {
        site && (
          <a class="site" href={site} target="_blank" rel="noopener noreferrer">
            {siteLabel(site)}
          </a>
        )
      }
    </p>
  </div>
</section>

<style>
  /* Media and caption take two rows of the parent grid, so side-by-side
     features share panel heights and their captions start on one line. */
  .feature {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 1.25rem;
  }

  /* The figure lays itself out against the card, not the viewport. */
  .media {
    display: grid;
    container-type: inline-size;
  }

  .caption {
    display: grid;
    gap: 0.375rem;
  }

  .name {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-feature);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--color-ink-1);
  }

  /* The marker that ranks this above the index rows below. */
  .name::before {
    content: "";
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
    background-color: var(--tone-fill);
  }

  /* Hovering the project turns its marker a quarter-turn into a diamond. */
  @media (hover: hover) and (pointer: fine) {
    .name::before {
      transition: rotate 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .feature:hover .name::before {
      rotate: 45deg;
    }
  }

  .name a {
    text-decoration-color: color-mix(in oklch, var(--tone-fill) 55%, transparent);
  }

  .desc {
    margin: 0;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .stack {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  .site {
    color: var(--color-ink-2);
  }

  .site::after {
    content: " ↗";
    color: var(--tone-fill);
  }
</style>
