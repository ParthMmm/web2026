---
import { elsewhere } from "../data/site";
---

<footer>
  <hr class="rule" />
  <div class="spine">
    <div class="rail">
      <h2 class="rail-label">Elsewhere</h2>
    </div>
    <ul class="flow links">
      {
        elsewhere.map((link) => (
          <li>
            <a href={link.url} rel="noopener noreferrer" target="_blank">
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  /* Same 3:1 split as a chapter rule, so the footer divider opens the footer
     instead of closing the chapter above it. */
  footer {
    padding-block-start: 2rem;
    padding-block-end: 4rem;
  }

  .spine {
    padding-block-start: 1.25rem;
  }

  /* Denser than the body of the page, same alignment and ink. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-1);
  }

  @media (min-width: 48rem) {
    footer {
      padding-block-start: 2.5rem;
    }

    .spine {
      padding-block-start: 1.75rem;
    }
  }
</style>
