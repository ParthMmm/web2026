---
type Props = {
	title: string;
	description: string;
	url?: string;
};

const { title, description, url } = Astro.props;
const isExternal = Boolean(url?.startsWith("http"));
const linkAttrs = isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<li class="row">
  <h3 class="title">{url ? <a href={url} {...linkAttrs}>{title}</a> : title}</h3>
  <p class="desc">{description}</p>
</li>

<style>
  /* Deliberately quieter and denser than a Feature: these are the supporting
     record, not the argument. One line each wherever the string allows. */
  .row {
    display: grid;
    gap: 0.125rem 1.5rem;
    padding-block: 0.6875rem;
    border-block-start: 1px solid var(--color-line);
  }

  .row:first-child {
    border-block-start: 0;
  }

  .title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink-1);
  }

  /* A tangerine arrow slides out of the title on hover or focus: ↗ leaves
     the site, → stays on it. */
  .title a::after {
    content: "→";
    display: inline-block;
    margin-inline-start: 0.375rem;
    color: var(--color-highlight);
    font-weight: 600;
    opacity: 0;
    translate: -0.375rem 0;
    transition:
      opacity 160ms ease-out,
      translate 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .title a[target="_blank"]::after {
    content: "↗";
  }

  .title a:focus-visible::after {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .title a:hover::after {
      opacity: 1;
      translate: 0 0;
    }
  }

  .desc {
    margin: 0;
    max-width: 34rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-3);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
