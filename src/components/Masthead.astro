---
import { profile } from "../data/site";
import { galleryBase } from "../lib/gallery";
import ThemeIcon from "./ThemeIcon.astro";

const isHome = Astro.url.pathname === "/";
/* The link appears once PUBLIC_GALLERY_URL is set, so production does not
   point anyone at a gallery that cannot load. */
const showPhotos = galleryBase(import.meta.env.PUBLIC_GALLERY_URL) !== null;
const onPhotos = Astro.url.pathname === "/photos/";
---

<header class="masthead">
  {
    isHome ? (
      <span class="name">{profile.name}</span>
    ) : (
      <a href="/" class="name">
        {profile.name}
      </a>
    )
  }
  <div class="end">
    {
      showPhotos && (
        <nav aria-label="Site">
          <a href="/photos/" class="nav-link" aria-current={onPhotos ? "page" : undefined}>
            Photos
          </a>
        </nav>
      )
    }
    <ThemeIcon />
  </div>
</header>
<hr class="rule" />

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.75rem 1.25rem;
  }

  /* The nameplate labels the document; it does not shout over it. The
     page-defining statement is the opening line below. */
  .name {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    color: var(--color-ink-1);
    text-decoration: none;
  }

  a.name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-primary-quiet);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* A second nameplate, a rung quieter: it is a way out, not the title. */
  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-3);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-ink-1);
    text-decoration-color: var(--color-highlight);
  }
</style>
