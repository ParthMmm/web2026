---
type Props = {
	/** Rail label: which part of the site this document belongs to. */
	section: string;
	sectionUrl: string;
	title: string;
	description?: string;
	/** Live site or repository, when the thing itself is reachable. */
	url?: string;
	urlLabel?: string;
};

const { section, sectionUrl, title, description, url, urlLabel } = Astro.props;
---

<article>
  <hr class="rule" />
  <div class="spine header">
    <div class="rail">
      <a href={sectionUrl} class="rail-label back">{section}</a>
    </div>
    <div class="flow">
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
      {
        url && (
          <p class="visit">
            <a href={url} rel="noopener noreferrer" target="_blank">
              {urlLabel ?? "Visit site"}
            </a>
          </p>
        )
      }
    </div>
  </div>
  <div class="spine body">
    <div class="rail" aria-hidden="true"></div>
    <div class="flow">
      <slot />
    </div>
  </div>
</article>

<style>
  .header {
    padding-block-start: 2rem;
  }

  .body {
    padding-block-start: 2.25rem;
    padding-block-end: 2.5rem;
  }

  .back {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-primary-quiet);
  }

  h1 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.024em;
    color: var(--color-ink-1);
  }

  .description {
    margin-block: 0.625rem 0;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  /* The one filled control on the site. It is the single primary action on a
     project page — the thing itself — so it is the only place the accent
     becomes a surface rather than a line. Every other control stays neutral. */
  .visit {
    margin-block: 1.5rem 0;
  }

  .visit a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.875rem;
    border-radius: 8px;
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .visit a {
      transition: opacity 150ms ease;
    }
    .visit a:hover {
      /* Stepping the fill back reads as a press rather than a new colour. */
      opacity: 0.88;
      color: var(--color-primary-foreground);
    }
  }

  .visit a:active {
    opacity: 0.8;
  }

  @media (min-width: 48rem) {
    .header {
      padding-block-start: 2.75rem;
    }

    .body {
      padding-block-start: 2.75rem;
      padding-block-end: 3.5rem;
    }

    h1 {
      font-size: 2rem;
    }
  }
</style>
