---
type Props = {
	url?: string;
	title: string;
	description: string;
};

const { url, title, description } = Astro.props;
const isExternal = url?.startsWith("http");
---

  <div class='mb-5'>
    <div class='flex flex-col items-start gap-1'>
      {
        url ? (
          <a
            href={url}
            class='card-title font-medium tracking-tight text-950'
            {...isExternal && { target: "_blank", rel: "noopener noreferrer" }}
          >
            {title}
          </a>
        ) : (
          <div class='font-medium tracking-tight text-950'>{title}</div>
        )
      }
      <span class='text-sm font-light text-600'>{description}</span>
    </div>
  </div>

<style>
  @media (hover: hover) and (pointer: fine) {
    .card-title:hover {
      color: var(--color-accent);
    }
    .card-title {
      transition: color 150ms ease;
    }
  }
</style>
