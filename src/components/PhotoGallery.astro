---
interface Props {
	/** The gallery base URL, or `null` while PUBLIC_GALLERY_URL is unset. */
	base: string | null;
}

const { base } = Astro.props;
---

{
  base === null ? (
    <div class="gallery" data-state="not-connected">
      <p class="status">The gallery isn’t connected yet.</p>
    </div>
  ) : (
    <div class="gallery" data-state="loading" data-gallery-base={base}>
      <p class="status" role="status" />
      <noscript>
        <p class="status">The photos need JavaScript to load.</p>
      </noscript>
      <button class="retry" type="button" hidden>
        Try again
      </button>
      <ul class="photo-grid" aria-label="Photos, newest first" hidden />

      <dialog class="viewer" aria-label="Photo">
        <figure class="stage">
          <img class="large" alt="" />
        </figure>
        <div class="bar">
          <p class="caption">
            <span class="count" />
            <span class="meta" />
          </p>
          <div class="controls">
            <button class="previous" type="button" aria-label="Previous photo">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M15 5.5 8.5 12l6.5 6.5" />
              </svg>
            </button>
            <button class="next" type="button" aria-label="Next photo">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M9 5.5 15.5 12 9 18.5" />
              </svg>
            </button>
            <button class="close" type="button" aria-label="Close" autofocus>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12M18 6 6 18" />
              </svg>
            </button>
          </div>
        </div>
      </dialog>
    </div>
  )
}

<script>
  import { mountGallery } from "./photo-gallery";

  for (const root of document.querySelectorAll<HTMLElement>("[data-gallery-base]")) {
    mountGallery(root);
  }
</script>

<style>
  /* Rows of equal height, each stretched to the column, so every photo keeps
     its whole frame and the order stays newest first, left to right. A tile
     grows in proportion to its aspect ratio, which keeps a row's heights
     equal. The row heights, the 48rem step and the gap match ROW_REM,
     WIDE_FROM_REM and GAP_REM in src/lib/gallery.ts. */
  .gallery {
    --row: 11rem;
  }

  @media (min-width: 48rem) {
    .gallery {
      --row: 15rem;
    }
  }

  .status {
    margin: 0;
    min-height: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.5rem;
    color: var(--color-ink-3);
  }

  /* Ready, the status only tells a screen reader how many photos loaded. */
  .gallery[data-state="ready"] .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .retry {
    margin-block-start: 0.75rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 6px;
    background: none;
    color: var(--color-ink-1);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .photo-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo-grid[hidden] {
    display: none;
  }

  /* Takes the slack in the last row, so its photos stay at row height
     instead of stretching to fill the column. */
  .photo-grid::after {
    content: "";
    flex-grow: 1000000;
  }

  .photo-grid > :global(li) {
    flex: var(--ar, 1) 1 calc(var(--ar, 1) * var(--row));
    min-width: 0;
  }

  .photo-grid :global(.photo-tile) {
    display: block;
    border-radius: 3px;
  }

  .photo-grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
    background-color: var(--color-hover);
    /* A hairline keeps a pale photo's edge on the cream page. */
    outline: 1px solid var(--color-line);
    outline-offset: -1px;
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-grid :global(img) {
      transition: opacity 150ms ease;
    }

    .photo-grid :global(.photo-tile:hover img) {
      opacity: 0.88;
    }
  }

  /* The larger view fills the screen with the page's own ground. */
  .viewer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right))
      max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
    border: 0;
    background-color: var(--color-canvas);
    color: var(--color-ink-1);
  }

  /* Fixed tracks, so the photo's width cap resolves against the screen and
     not against the photo, and a tall one cannot push the bar off it. */
  .viewer[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
  }

  .viewer::backdrop {
    background-color: var(--color-canvas);
  }

  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] {
      transition: opacity 180ms ease-out;
    }

    @starting-style {
      .viewer[open] {
        opacity: 0;
      }
    }
  }

  /* A horizontal drag is a swipe the script handles; the browser keeps
     vertical scroll and pinch zoom. */
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: 0;
    margin: 0;
    touch-action: pan-y pinch-zoom;
  }

  /* Sized to fit the stage by width or, for a tall photo, by height. The
     7rem is the dialog's padding, gap and bar with room to spare; sizesFor in
     src/lib/gallery.ts asks the browser for the same width. */
  .large {
    display: block;
    width: min(100%, (100dvh - 7rem) * var(--ar, 1.5));
    height: auto;
    max-height: 100%;
    object-fit: contain;
    background-position: center;
    background-size: cover;
    border-radius: 2px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
  }

  .caption {
    min-width: 0;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums;
  }

  .count {
    color: var(--color-ink-1);
    font-weight: 500;
  }

  /* On a phone the date and film take a second line instead of being cut. */
  .meta {
    display: block;
  }

  @media (min-width: 30rem) {
    .meta {
      display: inline;
    }

    .meta:not(:empty)::before {
      content: "·";
      margin-inline: 0.5rem;
    }
  }

  .controls {
    display: flex;
    flex-shrink: 0;
    gap: 0.25rem;
  }

  .controls button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--color-ink-3);
    cursor: pointer;
  }

  .controls svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .controls button:hover {
      background-color: var(--color-hover);
      color: var(--color-ink-1);
    }
  }

  .controls button:active {
    background-color: var(--color-pressed);
  }

  .controls button[aria-disabled="true"] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }
</style>
