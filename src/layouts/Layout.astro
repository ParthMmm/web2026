---
// import Footer from "../components/Footer.astro";
import "@fontsource/geist-mono";
type Props = {
	title: string;
	description: string;
	image?: string;
};
import "../styles/global.css";
import { SEO } from "astro-seo";
import Footer from "../components/Footer.astro";

const { title, description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || "/og.svg";
---

<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonicalURL.toString(),
        },
        image: {
          alt: "Parth Mangrola Website Screenshot",
          width: 1200,
          height: 630,
          type: "image/svg+xml",
        },
        optional: {
          siteName: "Parth Mangrola",
          description,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@parthmangrola",
        title,
        description,
        image: ogImage,
        imageAlt: "Parth Mangrola Website Screenshot"
      }}
      extend={{
        meta: [
          { name: "viewport", content: "width=device-width,initial-scale=1" },
          { name: "generator", content: Astro.generator },
          { name: "theme-color", content: "#879A39" },
          { name: "apple-mobile-web-app-capable", content: "yes" },
          { name: "apple-mobile-web-app-status-bar-style", content: "default" },
        ],
        link: [
          { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
          { rel: "manifest", href: "/manifest.json" },
        ],
      }}
    />
    
    <!-- global metadata -->
    <meta charset="utf-8" />

    <title>{title}</title>
  </head>
  <body class="bg-paper antialiased  dark:bg-black  dark:text-paper text-900 font-mono ">
    <main
    class="flex flex-col items-center justify-center w-full px-4 md:px-0 mt-8 md:max-w-3xl mx-auto"
    >
      <slot />

      <div class="container p-4 mx-auto">
      <Footer  />
      </div>
    </main>
  </body>
</html>

<style is:global>
  html {
    font-family: "Geist Mono", monospace;
  }
</style>
