---
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import "@fontsource/commit-mono/300.css";
import "@fontsource/commit-mono/400.css";
import "@fontsource/commit-mono/500.css";
import "@fontsource/commit-mono/700.css";
import "@fontsource/geist-mono";
type Props = {
	title: string;
	description: string;
	image?: string;
};
import "../styles/global.css";
import { SEO } from "astro-seo";
import Footer from "../components/Footer.astro";
import ThemeIcon from "../components/ThemeIcon.astro";
import Analytics from "@vercel/analytics/astro";

const { title, description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || "/og.svg";
---

<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonicalURL.toString(),
        },
        image: {
          alt: "Parth Mangrola Website Screenshot",
          width: 1200,
          height: 630,
          type: "image/svg+xml",
        },
        optional: {
          siteName: "Parth Mangrola",
          description,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@parthmangrola",
        title,
        description,
        image: ogImage,
        imageAlt: "Parth Mangrola Website Screenshot"
      }}
      extend={{
        meta: [
          { name: "viewport", content: "width=device-width,initial-scale=1" },
          { name: "generator", content: Astro.generator },
          { name: "theme-color", content: "#FFFCF0" },
          { name: "apple-mobile-web-app-capable", content: "yes" },
          { name: "apple-mobile-web-app-status-bar-style", content: "default" },
        ],
        link: [
          { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
          { rel: "manifest", href: "/manifest.json" },
        ],
      }}
    />

    <Analytics />

    <!-- global metadata -->
    <meta charset="utf-8" />

  </head>
  <body class="bg-paper antialiased text-900 font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-paper focus:text-950 focus:rounded focus:ring-2 focus:ring-accent">Skip to content</a>
    <div class="fixed top-4 right-4 z-50">
      <ThemeIcon />
    </div>
    <main
    id="main"
    class="flex flex-col items-center justify-center w-full px-4 md:px-0 mt-8 md:max-w-3xl mx-auto"
    >
      <slot />

      <div class="container p-4 mx-auto">
      <Footer  />
      </div>
    </main>
  </body>
</html>

<style is:global>
  html {
    font-family: "Inter", system-ui, sans-serif;
  }
  html.dark {
    font-family: "Commit Mono", monospace;
  }
</style>
