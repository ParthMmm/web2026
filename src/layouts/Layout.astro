---
import "@fontsource/geist-mono/400.css";
import "../styles/global.css";

import { SEO } from "astro-seo";
import Footer from "../components/Footer.astro";
import Masthead from "../components/Masthead.astro";
import { ogImageAlt as cardAlt, ogImagePath } from "../data/og";

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Short description of the share image for screen readers and link previews. */
	imageAlt?: string;
	/** For a page with no address of its own, such as the not-found page:
	    keeps it out of search results and gives it no canonical or share URL. */
	noindex?: boolean;
}

const { title, description, image, imageAlt, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
/* Link unfurlers don't resolve relative URLs, so the image must be absolute. */
const ogImage = new URL(image ?? ogImagePath(Astro.url.pathname), Astro.site).toString();
const ogImageAlt = imageAlt ?? cardAlt(Astro.url.pathname);
const share = {
	openGraph: {
		basic: {
			image: ogImage,
			title,
			type: "website",
			url: canonicalURL.toString(),
		},
		image: {
			alt: ogImageAlt,
			height: 630,
			type: "image/png",
			width: 1200,
		},
		optional: {
			description,
			siteName: "Parth Mangrola",
		},
	},
	twitter: {
		card: "summary_large_image" as const,
		creator: "@parthmangrola",
		description,
		image: ogImage,
		imageAlt: ogImageAlt,
		site: "@parthmangrola",
		title,
	},
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <SEO
      title={title}
      description={description}
      noindex={noindex}
      canonical={noindex ? null : canonicalURL.toString()}
      {...(noindex ? {} : share)}
      extend={{
        meta: [
          { name: "author", content: "Parth Mangrola" },
          { name: "viewport", content: "width=device-width,initial-scale=1" },
          { name: "generator", content: Astro.generator },
          { name: "theme-color", content: "#fcf6e9" },
          { name: "apple-mobile-web-app-capable", content: "yes" },
          { name: "apple-mobile-web-app-status-bar-style", content: "default" },
        ],
        link: [
          { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
          { rel: "manifest", href: "/manifest.json" },
        ],
      }}
    />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <div class="page">
      <Masthead />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    margin: 0;
    /* Runs standalone (apple-mobile-web-app-capable + manifest display), so
       there is no browser chrome to keep content clear of the notch or the
       home indicator. Safe areas are physical geometry, so these stay
       physical rather than logical. */
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    padding-bottom: env(safe-area-inset-bottom);
    background-color: var(--color-canvas);
    color: var(--color-ink-1);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
  }

  .skip {
    position: absolute;
    inset-inline-start: -9999px;
  }

  .skip:focus {
    inset-inline-start: 1.5rem;
    top: calc(1.5rem + env(safe-area-inset-top));
    z-index: 10;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-canvas);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
</style>
