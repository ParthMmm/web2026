---
import { getEntry, render } from "astro:content";
import ContentWrapper from "../../components/ContentWrapper.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const title = "Tracklister - Turn Tracklists into Playlists";
const description = "A web app that turns tracklists into Spotify playlists.";
const projectUrl = "https://tracklister.p11a.xyz/";

const entry = await getEntry("projects", "tracklister");
const { Content } = await render(entry!);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Tracklister",
	applicationCategory: "WebApplication",
	operatingSystem: "Any",
	url: projectUrl,
	author: {
		"@type": "Person",
		name: "Parth Mangrola",
		url: "https://www.parthm.dev",
	},
	description: description,
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	programmingLanguage: ["TypeScript", "React"],
	featureList: "Convert text tracklists to Spotify playlists",
};
---

<Layout 
  title={title}
  description={description} 
  image="/og.svg"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container p-4 mx-auto">
    <ContentWrapper>
      <article class="prose prose-neutral dark:prose-invert max-w-none">
        <header class="mb-8">
          <h1 class="flex items-center gap-2 align-middle decoration-[1px] underline decoration-blue-400 underline-offset-4">
            <a
              href={projectUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="font-bold tracking-tighter"
              aria-label="Visit Tracklister website"
            >
              Tracklister
            </a>
          </h1>
          <p class="text-lg text-neutral-600 dark:text-neutral-400 mt-2">
            {description}
          </p>
        </header>

        <div class="project-content">
          <Content/>
        </div>
      </article>
    </ContentWrapper>
  </div>
</Layout>
