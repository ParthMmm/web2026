---
import { getEntry, render } from "astro:content";
import Article from "../../components/Article.astro";
import ContentWrapper from "../../components/ContentWrapper.astro";
import Layout from "../../layouts/Layout.astro";

const title = "Beacon";
const description =
	"Real-time shared workspace for planning trips together. Built on Expo and Convex, with markdown import and export.";

const entry = await getEntry("projects", "beacon");
const { Content } = await render(entry!);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Beacon",
	applicationCategory: "TravelApplication",
	operatingSystem: "iOS",
	author: {
		"@type": "Person",
		name: "Parth Mangrola",
		url: "https://www.parthm.dev",
	},
	description,
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout title={`${title} — Parth Mangrola`} {description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Article section="Projects" sectionUrl="/projects" {title} {description}>
    <ContentWrapper>
      <Content />
    </ContentWrapper>
  </Article>
</Layout>
