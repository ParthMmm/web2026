---
import { getEntry, render } from "astro:content";
import ContentWrapper from "../../components/ContentWrapper.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const title = "Beacon - Plan anywhere. Travel everywhere.";
const description = "Plan anywhere. Travel everywhere. Smart travel companion for collaborative trip planning.";

const entry = await getEntry("projects", "beacon");
const { Content } = await render(entry!);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Beacon",
	applicationCategory: "WebApplication",
	operatingSystem: "Any",
	author: {
		"@type": "Person",
		name: "Parth Mangrola",
		url: "https://www.parthm.dev",
	},
	description: description,
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
};
---

<Layout
  title={title}
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container p-4 mx-auto">
    <ContentWrapper>
      <article class="max-w-none">
        <header class="mb-8">
          <h1 class="flex items-center gap-2 align-middle decoration-[1px] underline decoration-accent underline-offset-4">
            <span class="font-bold tracking-tighter">
              Beacon
            </span>
          </h1>
          <p class="text-lg text-600 mt-2">
            {description}
          </p>
        </header>

        <div class="project-content">
          <Content/>
        </div>
      </article>
    </ContentWrapper>
  </div>
</Layout>
