---
import { getCollection, render } from "astro:content";
import Article from "../../components/Article.astro";
import Layout from "../../layouts/Layout.astro";
import Versions from "../../components/Versions.astro";

const title = "Versos";
const description =
	"Turns a DJ set's tracklist into a playlist. Started as Tracklister and rebuilt three times, from one Next.js app to Cloudflare to Effect and Apple Music.";

const entries = await getCollection("projects", ({ id }) => id.startsWith("versos/"));
entries.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const versions = await Promise.all(
	entries.map(async (entry) => {
		const { Content } = await render(entry);
		return {
			version: entry.data.version ?? entry.id,
			title: entry.data.title,
			description: entry.data.description,
			period: entry.data.period,
			Content,
		};
	}),
);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Versos",
	alternateName: "Tracklister",
	applicationCategory: "WebApplication",
	operatingSystem: "Any",
	author: {
		"@type": "Person",
		name: "Parth Mangrola",
		url: "https://www.parthm.dev",
	},
	description,
	programmingLanguage: ["TypeScript", "React"],
	featureList: "Convert text tracklists to streaming playlists",
};
---

<Layout title={`${title} — Parth Mangrola`} {description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Article section="Projects" sectionUrl="/projects" {title} {description}>
    <Versions {versions} />
  </Article>
</Layout>
