---
import type { GetStaticPaths } from "astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Article from "../../components/Article.astro";
import ContentWrapper from "../../components/ContentWrapper.astro";
import Versions from "../../components/Versions.astro";
import { profile, projects, siteLabel } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

/* A project is one write-up, `<slug>.md`, or a folder of versions,
   `<slug>/v1.md`, `<slug>/v2.md`, … for a project rebuilt more than once. */
export const getStaticPaths = (async () => {
	const groups = new Map<string, CollectionEntry<"projects">[]>();
	for (const entry of await getCollection("projects")) {
		const [slug = entry.id] = entry.id.split("/");
		groups.set(slug, [...(groups.get(slug) ?? []), entry]);
	}
	return [...groups].map(([slug, entries]) => ({
		params: { slug },
		props: { entries: entries.toSorted((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()) },
	}));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { entries } = Astro.props;
const isVersioned = entries.some((entry) => entry.id.includes("/"));
const latest = entries.at(-1) ?? entries[0];

const versions = await Promise.all(
	entries.map(async (entry) => {
		const { Content } = await render(entry);
		return {
			version: entry.data.version ?? entry.id,
			title: entry.data.title,
			description: entry.data.description,
			period: entry.data.period,
			Content,
		};
	}),
);
const { Content } = versions.at(-1) ?? versions[0];

const record = projects.find((project) => project.url === `/projects/${slug}`);
const title = record?.title ?? latest.data.title;
const description = record?.description ?? latest.data.description;
const site = record?.site;
const isRepo = site?.startsWith("https://github.com/") ?? false;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: title,
	description,
	url: site ?? new URL(`/projects/${slug}`, profile.site).toString(),
	applicationCategory: latest.data.applicationCategory,
	operatingSystem: latest.data.operatingSystem,
	datePublished: entries[0].data.pubDate.toISOString().slice(0, 10),
	author: { "@type": "Person", name: profile.name, url: profile.site },
	codeRepository: isRepo ? site : undefined,
};
---

<Layout title={`${title} — Parth Mangrola`} {description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Article
    section="Projects"
    sectionUrl="/projects"
    {title}
    {description}
    url={site}
    urlLabel={site && (isRepo ? "View on GitHub" : `Visit ${siteLabel(site)}`)}
  >
    {
      isVersioned ? (
        <Versions {versions} />
      ) : (
        <ContentWrapper>
          <Content />
        </ContentWrapper>
      )
    }
  </Article>
</Layout>
