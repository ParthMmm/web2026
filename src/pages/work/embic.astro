---
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

import ContentWrapper from "../../components/ContentWrapper.astro";

const title = "embic";
const entry = await getEntry("work", "embic");
const { Content } = await render(entry!);
---

<Layout {title} description="Built healthcare platform with admin dashboard for managing medical orgs and patient records." image="">
  <div class="container p-4 mx-auto">
<ContentWrapper>
      <Content/>
</ContentWrapper>
  </div>
</Layout>
