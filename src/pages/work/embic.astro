---
import { getEntry, render } from "astro:content";
import Article from "../../components/Article.astro";
import ContentWrapper from "../../components/ContentWrapper.astro";
import Layout from "../../layouts/Layout.astro";

const title = "Embic";
const description =
	"Healthcare platform with an admin dashboard for medical organizations and patient records. Fixed production bugs affecting 125+ users.";

const entry = await getEntry("work", "embic");
const { Content } = await render(entry!);
---

<Layout title={`${title} — Parth Mangrola`} {description}>
  <Article section="Work" sectionUrl="/work" {title} {description}>
    <ContentWrapper>
      <Content />
    </ContentWrapper>
  </Article>
</Layout>
