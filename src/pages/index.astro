---
import Chapter from "../components/Chapter.astro";
import Feature from "../components/Feature.astro";
import IndexRow from "../components/IndexRow.astro";
import BeaconMarkdown from "../components/media/BeaconMarkdown.astro";
import TracklistParse from "../components/media/TracklistParse.astro";
import { profile, projects, work } from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Parth Mangrola";
const description =
	"Full-stack engineer building products end to end — frontends, APIs, databases, and the infrastructure underneath.";

const FLAGSHIPS = new Set(["Beacon", "Versos"]);
const otherProjects = projects.filter((p) => !FLAGSHIPS.has(p.title));

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: profile.name,
	jobTitle: profile.role,
	url: profile.site,
	sameAs: [
		"https://github.com/ParthMmm",
		"https://www.linkedin.com/in/parthmangrola",
		"https://twitter.com/parthmangrola",
	],
	worksFor: { "@type": "Organization", name: "Pallas", url: "https://pallas.so" },
	knowsAbout: [
		"React",
		"TypeScript",
		"Node.js",
		"PostgreSQL",
		"AWS",
		"Cloudflare",
		"Full Stack Development",
		"Software Engineering",
	],
	workExample: work.map((item) => ({
		"@type": "CreativeWork",
		name: item.title,
		description: item.description,
	})),
};
---

<Layout {title} {description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="opening" aria-labelledby="thesis">
    <h1 id="thesis" class="thesis">
      I build products <mark>end to end</mark>.
    </h1>
    <p class="sub">
      Frontends, APIs, databases, and the infrastructure underneath.
    </p>
    <p class="lede">
      I run <a href="https://pallas.so" rel="noopener noreferrer">Pallas</a>, where I've
      shipped healthcare platforms, compliance SaaS, and developer tools for clients. I'm
      looking for a full-stack or design engineering role — somewhere the details matter.
    </p>
  </section>

  <Chapter label="Projects">
    <Feature
      title="Beacon"
      description="A real-time shared workspace for planning trips together. Your plans aren't locked in — import and export the whole itinerary as markdown."
      url="/projects/beacon"
      stack="Expo · Convex · Better Auth · Turborepo"
    >
      <BeaconMarkdown />
    </Feature>

    <Feature
      title="Versos"
      description="Paste a tracklist from a DJ set and get a playlist. An LLM cleans the messy text, then a matching engine finds each track in the catalogue. Three rebuilds in, formerly Tracklister."
      url="/projects/versos"
      stack="TanStack Start · Hono · Effect · BullMQ"
    >
      <TracklistParse />
    </Feature>

    <ul class="index tail">
      {otherProjects.map((project) => <IndexRow {...project} />)}
    </ul>
  </Chapter>

  <Chapter label="Work">
    <ul class="index">
      {work.map((item) => <IndexRow {...item} />)}
    </ul>
  </Chapter>

</Layout>

<style>
  .opening {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .thesis {
    margin: 0;
    max-width: 14ch;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.042em;
    color: var(--color-ink-1);
  }

  .sub {
    margin-block: clamp(1.25rem, 2.5vw, 1.75rem) 0;
    max-width: 26ch;
    font-size: clamp(1.125rem, 1.9vw, 1.5rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.018em;
    color: var(--color-ink-3);
  }

  .lede {
    margin-block: 1.75rem 0;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  .index {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The remaining projects are the tail of the same chapter, not a new
     one, so they sit closer to the features than a chapter break would. */
  .tail {
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
