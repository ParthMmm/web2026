# Optional. Empty values turn that source off.

# Orbis Presence: a Person who can see you (not your own key).
ORBIS_API_KEY=
ORBIS_USERNAME=

# Last.fm, typically fed by NepTunes on the laptop.
LASTFM_API_KEY=
LASTFM_USER=

# MusicKit. Create a Media Services key in App Store Connect, then run
# `bun workers/now-playing/authorize.ts` to mint APPLE_MUSIC_USER_TOKEN.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_USER_TOKEN=

# The public gallery's base URL, without a trailing slash. Unset, /photos/
# says the gallery is not connected and the masthead does not link to it.
# Locally: http://127.0.0.1:8787/gallery
PUBLIC_GALLERY_URL=
